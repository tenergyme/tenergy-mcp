{
  "name": "@tenergy/mcp",
  "version": "0.1.0-beta.0",
  "description": "Model Context Protocol server over the tenergy public API and @tenergy/sdk (stdio + streamable HTTP).",
  "license": "MIT",
  "author": "TEnergy",
  "homepage": "https://tenergy.me/docs/mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "tron",
    "trx",
    "energy",
    "energy-rental",
    "usdt"
  ],
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "tenergy-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76",
    "@tenergy/sdk": "^0.1.0-beta.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenergyme/tenergy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tenergyme/tenergy-mcp/issues"
  }
}
